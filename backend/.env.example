APP_NAME=Sou2AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
# Empty by default. Add only the actual reverse-proxy network ranges.
TRUSTED_PROXY_CIDRS=
MAX_REQUEST_BODY_BYTES=65536
# Private source documents are accepted only on the knowledge upload routes.
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880
KNOWLEDGE_MAX_PDF_PAGES=100
KNOWLEDGE_MAX_TEXT_CHARACTERS=500000
KNOWLEDGE_MAX_CHUNKS=500
KNOWLEDGE_STORAGE_ROOT=../data/knowledge
REDIS_URL=redis://127.0.0.1:6379/0
KNOWLEDGE_QUEUE_NAME=knowledge
KNOWLEDGE_WORKER_TIMEOUT_SECONDS=120
API_DOCS_ENABLED=true
HSTS_ENABLED=false
TRUSTED_HTTPS_TERMINATION=false
LOG_LEVEL=INFO
# Local development uses Ollama for every business. Set mock only for explicit
# offline development or tests; provider selection changes require a restart.
OWNER_CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3
# Embeddings use the same private local Ollama base URL and HTTP timeout.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=16
RETRIEVAL_CANDIDATE_LIMIT=10
RETRIEVAL_MINIMUM_SIMILARITY=0.50
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Local-development credentials only. Replace them outside local development.
POSTGRES_USER=sou2ai
POSTGRES_PASSWORD=sou2ai_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_DEV_DB=sou2ai_dev
POSTGRES_TEST_DB=sou2ai_test
POSTGRES_RUNTIME_USER=sou2ai_runtime_login
POSTGRES_RUNTIME_PASSWORD=sou2ai_runtime_local
POSTGRES_LIFECYCLE_OPERATOR_USER=sou2ai_lifecycle_operator_login
POSTGRES_LIFECYCLE_OPERATOR_PASSWORD=sou2ai_lifecycle_operator_local
# FastAPI uses only the restricted runtime login.
POSTGRESQL_DATABASE_URL=postgresql+psycopg://sou2ai_runtime_login:sou2ai_runtime_local@127.0.0.1:5433/sou2ai_dev
TEST_POSTGRESQL_DATABASE_URL=postgresql+psycopg://sou2ai_runtime_login:sou2ai_runtime_local@127.0.0.1:5433/sou2ai_test
# Alembic uses the trusted bootstrap login and assigns protected ownership to
# the NOLOGIN sou2ai_migrator role.
MIGRATION_POSTGRESQL_DATABASE_URL=postgresql+psycopg://sou2ai:sou2ai_local@127.0.0.1:5433/sou2ai_dev
TEST_MIGRATION_POSTGRESQL_DATABASE_URL=postgresql+psycopg://sou2ai:sou2ai_local@127.0.0.1:5433/sou2ai_test
# Used only by manual lifecycle operations, never by FastAPI.
LIFECYCLE_OPERATOR_POSTGRESQL_DATABASE_URL=postgresql+psycopg://sou2ai_lifecycle_operator_login:sou2ai_lifecycle_operator_local@127.0.0.1:5433/sou2ai_dev
TEST_LIFECYCLE_OPERATOR_POSTGRESQL_DATABASE_URL=postgresql+psycopg://sou2ai_lifecycle_operator_login:sou2ai_lifecycle_operator_local@127.0.0.1:5433/sou2ai_test
POSTGRESQL_CONNECT_TIMEOUT_SECONDS=5
TOOL_CALL_AUDIT_RETENTION_DAYS=90
# Required only when the future centralized tool executor begins hashing arguments.
TOOL_CALL_AUDIT_HMAC_SECRET=
# Authentication. Generate a long random ACCESS_TOKEN_SECRET outside development.
# Authentication events default to 24 hours and cannot be retained for less than 2.
AUTH_EVENT_RETENTION_HOURS=24
# PostgreSQL permits one cleanup attempt per shared interval across all API workers.
AUTH_EVENT_CLEANUP_INTERVAL_MINUTES=60
ACCESS_TOKEN_SECRET=development-only-change-this-access-token-secret
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MINUTES=15
ACCESS_TOKEN_ISSUER=sou2ai
ACCESS_TOKEN_AUDIENCE=sou2ai-api
REFRESH_SESSION_LIFETIME_DAYS=1
REMEMBERED_REFRESH_SESSION_LIFETIME_DAYS=30
REFRESH_COOKIE_NAME=sou2ai_refresh_token
# Keep false for local HTTP only; production validation requires true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth
# Resend testing can use onboarding@resend.dev only for the account owner's email.
RESEND_API_KEY=re_test_replace_me
RESEND_SENDER_EMAIL=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:5173
VERIFICATION_LINK_PATH=/verify-email
PASSWORD_RESET_LINK_PATH=/reset-password
# Owner chat. Messages always use the newest 12; knowledge candidates are bounded.
OWNER_CHAT_KNOWLEDGE_CONTEXT_LIMIT=100
# Claims coordinate replicas without holding a transaction during generation.
OWNER_CHAT_GENERATION_LEASE_SECONDS=150
OWNER_CHAT_GENERATION_WAIT_SECONDS=30
OWNER_CHAT_MAX_OUTPUT_TOKENS=512
# One shared PostgreSQL-coordinated retention attempt per interval.
SECURITY_EVENT_CLEANUP_INTERVAL_MINUTES=60
